---
import Page from '../layouts/Page.astro';
import {readRepoFile} from '../lib/repo-markdown';

const RELEASE = 'https://github.com/thenotoriousfox/riverhorse/releases/latest/download/';

const platforms = [
	{id: 'linux', name: 'Linux', downloads: [
		{label: 'AppImage (x64)', file: 'Riverhorse-x64.AppImage', arch: 'x64'},
		{label: 'AppImage (ARM64)', file: 'Riverhorse-arm64.AppImage', arch: 'arm64'},
		{label: 'Flatpak (x64)', file: 'riverhorse-x64.flatpak'},
		{label: 'Flatpak (ARM64)', file: 'riverhorse-arm64.flatpak'},
	]},
	{id: 'windows', name: 'Windows', downloads: [
		{label: 'Windows (x64)', file: 'riverhorse-windows-x64-release.zip', arch: 'x64'},
		{label: 'Windows (ARM64)', file: 'riverhorse-windows-arm64-release.zip', arch: 'arm64'},
	]},
	{id: 'macos', name: 'macOS', downloads: [
		{label: 'macOS (Apple silicon and Intel)', file: 'riverhorse-mac-release.zip', arch: 'any'},
	]},
];

const shots = [
	{file: 'home', alt: 'The Riverhorse Big Picture home screen with a Continue Playing card, a library cover shelf and the selected game\'s art behind it', caption: 'Big Picture: pick up where you left off, or browse your library with a controller.'},
	{file: 'spyro', alt: 'Spyro the Dragon running in Riverhorse', caption: 'Hardware rendering with upscaling and PGXP geometry correction.'},
	{file: 'desktop', alt: 'The Riverhorse desktop window listing games with covers, serials and compatibility ratings', caption: 'The desktop window, with covers, serials and compatibility at a glance.'},
	{file: 'symphony', alt: 'Castlevania: Symphony of the Night title screen in Riverhorse', caption: '2D games look as sharp as the original, at any window size.'},
];

const changelog = await readRepoFile('CHANGELOG.md');
const latest = changelog.match(/^## (\d+\.\d+\.\d+) \((\d{4}-\d{2}-\d{2})\)/m);
const released = latest && new Date(`${latest[2]}T00:00:00Z`).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'});
---
<Page wide>
<section class="hero">
	<img src="/riverhorse.png" alt="Riverhorse" width="160" height="160" />
	<h1>Riverhorse</h1>
	<p class="tagline">A PlayStation emulator that starts straight into the game.</p>
	<p class="lede">Accurate PS1 emulation for Linux, Windows, macOS and RetroArch, with rollback netplay, save sync between devices and an interface you can drive with a controller. It runs well on low-end ARM handhelds too.</p>
	<p class="cta">
		<a id="download-main" class="button primary" href="#download">Download</a>
		<a class="button" href="/docs/getting-started">Get started</a>
	</p>
	{latest && <p class="version">Version <a href={`/changelog#v${latest[1]}`}>{latest[1]}</a>, released {released}</p>}
</section>

<section class="shots" aria-label="Screenshots">
	{shots.map(shot => (
		<figure>
			<a href={`/shots/${shot.file}.webp`}><img src={`/shots/${shot.file}.webp`} alt={shot.alt} loading="lazy" /></a>
			<figcaption>{shot.caption}</figcaption>
		</figure>
	))}
</section>

<section class="features">
	<article>
		<h2>Accurate</h2>
		<p>CD-ROM timing modelled on hardware measurements, reworked GPU, SPU, DMA, MDEC and GTE timing, and extended PGXP geometry correction.</p>
	</article>
	<article>
		<h2>Rollback netplay</h2>
		<p>Up to four players and four spectators. Find a game in the lobby, host one from your library, or join a friend with a session code.</p>
	</article>
	<article>
		<h2>Save sync</h2>
		<p>Memory cards, save states and game settings follow you between devices through a synced folder or a WebDAV server.</p>
	</article>
	<article>
		<h2>Looks great</h2>
		<p>Software, OpenGL, Vulkan, Direct3D and Metal renderers, upscaling, widescreen and 60 FPS patches, shaders and bezels.</p>
	</article>
	<article>
		<h2>Made for the couch</h2>
		<p>A fullscreen interface with cover shelves, a Continue Playing card, a rewind timeline and an in-game side panel, and themes for dark, light and high contrast.</p>
	</article>
	<article>
		<h2>Cheats and patches</h2>
		<p>About 66,000 cheats for over 1,900 games, plus fix patches, and your own patches per game.</p>
	</article>
</section>

<section id="download" class="download">
	<h2>Download</h2>
	<p>You also need a BIOS dumped from your own console; see <a href="/docs/getting-started#bios">Getting started</a>. Older versions are on <a href="https://github.com/thenotoriousfox/riverhorse/releases">GitHub</a>.</p>
	<div class="platforms">
		{platforms.map(platform => (
			<div class="platform" data-platform={platform.id}>
				<h3>{platform.name}</h3>
				{platform.downloads.map((download, index) => (
					<a class:list={['button', {primary: index === 0}]} href={RELEASE + download.file} data-arch={download.arch} data-label={`Download for ${platform.name}`}>{download.label}</a>
				))}
			</div>
		))}
		<div class="platform" data-platform="libretro">
			<h3>libretro core</h3>
			<p>For RetroArch and other libretro frontends, on Linux, Windows, Android and macOS. Pick your platform from the <a href="https://github.com/thenotoriousfox/riverhorse/releases/latest">release page</a> (<code>riverhorse_libretro-&lt;platform&gt;.zip</code>) and see <a href="/docs/libretro-core">installing the core</a>.</p>
		</div>
	</div>
</section>
</Page>

<script>
	interface HighEntropyNavigator {
		userAgentData?: {platform: string; getHighEntropyValues(hints: string[]): Promise<{architecture?: string}>};
	}

	async function detect(): Promise<{platform: string; arch: string} | null> {
		const nav = navigator as Navigator & HighEntropyNavigator;
		const agent = navigator.userAgent;
		const platform = /Android|iPhone|iPad/i.test(agent) ? null
			: /Windows/i.test(agent) ? 'windows'
			: /Mac OS X|Macintosh/i.test(agent) ? 'macos'
			: /Linux|X11/i.test(agent) ? 'linux' : null;
		if (!platform) return null;
		let arch = /aarch64|arm64/i.test(agent) ? 'arm64' : 'x64';
		if (nav.userAgentData) {
			const values = await nav.userAgentData.getHighEntropyValues(['architecture']).catch(() => ({architecture: undefined}));
			if (values.architecture === 'arm') arch = 'arm64';
		}
		return {platform, arch};
	}

	detect().then(found => {
		if (!found) return;
		const card = document.querySelector<HTMLElement>(`.platform[data-platform="${found.platform}"]`);
		const link = card?.querySelector<HTMLAnchorElement>(`a[data-arch="${found.arch}"]`)
			?? card?.querySelector<HTMLAnchorElement>('a[data-arch="any"]');
		const main = document.getElementById('download-main') as HTMLAnchorElement;
		if (!card || !link) return;
		main.href = link.href;
		main.textContent = `${link.dataset.label} · ${link.textContent}`;
		card.classList.add('detected');
	});
</script>
