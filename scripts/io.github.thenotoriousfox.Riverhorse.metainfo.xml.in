<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>io.github.thenotoriousfox.Riverhorse</id>
  <launchable type="desktop-id">io.github.thenotoriousfox.Riverhorse.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Riverhorse</name>
  <developer id="io.github.thenotoriousfox">
    <name>Daniel Weatherall</name>
  </developer>
  <summary>PlayStation Emulator</summary>
  <description>
    <p>Riverhorse is an simulator/emulator of the Sony PlayStation(TM) console, focusing on playability, speed, and long-term maintainability. The goal is to be as accurate as possible while maintaining performance suitable for low-end devices.</p>
    <p>"Hack" options are discouraged, the default configuration should support all playable games with only some of the enhancements having compatibility issues.</p>
    <p>Riverhorse is based on DuckStation v0.1-7371 by Connor McLaughlin and contributors.</p>
    <p>"PlayStation" and "PSX" are registered trademarks of Sony Interactive Entertainment Europe Limited. This project is not affiliated in any way with Sony Interactive Entertainment.</p>
  </description>
  <content_rating type="oars-1.1"/>
  <url type="homepage">https://github.com/thenotoriousfox/riverhorse</url>
  <url type="bugtracker">https://github.com/thenotoriousfox/riverhorse/issues</url>
  <url type="vcs-browser">https://github.com/thenotoriousfox/riverhorse</url>
  <releases>
    <release version="@GIT_VERSION@" date="@GIT_DATE@" />
  </releases>
  <custom>
    <value key="flathub::manifest">https://raw.githubusercontent.com/thenotoriousfox/riverhorse/@GIT_HASH@/scripts/flatpak/io.github.thenotoriousfox.Riverhorse.yaml</value>
  </custom>
</component>
